<?xml version="1.0"?>
<!-- 67 mm nominal diameter, 57 g, finite-wall inertia 0.55 mR^2 (Cross 2002, 2010).
     Contact response still requires independent court/racket calibration. -->
<robot name="ball">
  <link name="ball">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.0335"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.0335"/></geometry>
    </collision>
    <inertial>
      <mass value="0.057"/>
      <inertia ixx="0.0000351825375" ixy="0.0" ixz="0.0" iyy="0.0000351825375" iyz="0.0" izz="0.0000351825375"/>
    </inertial>
  </link>
</robot>
